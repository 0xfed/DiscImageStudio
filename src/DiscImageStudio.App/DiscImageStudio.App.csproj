<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- WPF text and font services require named cultures such as en and zh-CN. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>DiscImageStudio</AssemblyName>
    <RootNamespace>DiscImageStudio</RootNamespace>
    <StartupObject>DiscImageStudio.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DiscImageStudio.ico</ApplicationIcon>
    <Title>Disc Image Studio</Title>
    <Product>Disc Image Studio</Product>
    <Description>Create and stream-burn image-mapped CD audio tracks and DVD data discs.</Description>
    <Company>Disc Image Studio</Company>
    <Copyright>Copyright © 2026</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="MahApps.Metro.IconPacks.Lucide" Version="6.2.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DiscImageStudio.Core\DiscImageStudio.Core.csproj" />
    <ProjectReference Include="..\DiscImageStudio.ImageIO\DiscImageStudio.ImageIO.csproj" />
    <Compile Include="../Shared/BluRayImageLoader.cs" Link="Services/BluRayImageLoader.cs" />
    <Compile Include="../Shared/ConsoleModuleRunner.cs" Link="ConsoleModuleRunner.cs" />
    <ProjectReference Include="..\DiscImageStudio.Burning\DiscImageStudio.Burning.csproj" />
    <ProjectReference Include="..\DiscImageStudio.Imaging\DiscImageStudio.Imaging.csproj" />
    <ProjectReference Include="..\DiscImageStudio.Cd\DiscImageStudio.Cd.csproj" />
    <ProjectReference Include="..\DiscImageStudio.Dvd\DiscImageStudio.Dvd.csproj" />
    <ProjectReference Include="..\DiscImageStudio.BluRay\DiscImageStudio.BluRay.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\HarmonyOS_Sans_SC_Regular.ttf" />
    <Resource Include="Assets\Fonts\HarmonyOS_Sans_SC_Medium.ttf" />
    <Resource Include="Assets\Fonts\HarmonyOS_Sans_SC_Bold.ttf" />
    <Resource Include="Assets\DiscImageStudio-256.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="DiscImageStudio.Licenses.GPL" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="DiscImageStudio.Licenses.ThirdParty" />
    <EmbeddedResource Include="Assets\Fonts\HarmonyOS-Sans-LICENSE.txt" LogicalName="DiscImageStudio.Licenses.HarmonyOS" />
  </ItemGroup>
  <Target Name="RejectInvariantGlobalizationForWpf" BeforeTargets="PrepareForBuild"
          Condition="'$(InvariantGlobalization)' == 'true'">
    <Error Text="DiscImageStudio.App cannot use invariant globalization because WPF font rendering requires named cultures." />
  </Target>
  <Target Name="ExcludeHostedSolverLaunchArtifacts" BeforeTargets="_HandleFileConflictsForPublish">
    <!-- The app hosts the solver DLL using its own launcher and dependency graph.
         WPF can collect both RID and non-RID solver outputs during publish. -->
    <PropertyGroup>
      <_HostedSolverDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', 'DvdImageSolver'))</_HostedSolverDirectory>
    </PropertyGroup>
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').StartsWith('$(_HostedSolverDirectory)'))
                     And ('%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'DvdImageSolver.runtimeconfig.json'
                       Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'DvdImageSolver.deps.json'
                       Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'DvdImageSolver.exe'
                       Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'DvdImageSolver'
                       Or '%(ResolvedFileToPublish.Filename)' == 'apphost')" />
    </ItemGroup>
  </Target>
</Project>
