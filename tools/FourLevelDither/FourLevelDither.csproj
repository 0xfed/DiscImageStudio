<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>FourLevelDither</AssemblyName>
    <RootNamespace>DiscImageStudio.DitherTool</RootNamespace>
    <ApplicationIcon>../../src/DiscImageStudio.App/Assets/DiscImageStudio.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DiscImageStudio.Core/DiscImageStudio.Core.csproj" />
    <ProjectReference Include="../../src/DiscImageStudio.Imaging/DiscImageStudio.Imaging.csproj" />
    <ProjectReference Include="../../src/DiscImageStudio.Localization/DiscImageStudio.Localization.csproj" />
    <Compile Include="../../src/DiscImageStudio.App/Localization/TextExtension.cs" Link="Localization/TextExtension.cs" />
  </ItemGroup>
</Project>
