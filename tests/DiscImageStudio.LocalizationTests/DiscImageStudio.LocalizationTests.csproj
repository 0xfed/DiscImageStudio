<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exercise the actual runtime and catalogs without requiring Windows/WPF. -->
    <ProjectReference Include="../../src/DiscImageStudio.Localization/DiscImageStudio.Localization.csproj" />
    <ProjectReference Include="../../src/DiscImageStudio.BluRay/DiscImageStudio.BluRay.csproj" />
    <ProjectReference Include="../../src/DiscImageStudio.Cd/DiscImageStudio.Cd.csproj" />
    <ProjectReference Include="../../src/DiscImageStudio.Dvd/DiscImageStudio.Dvd.csproj" />
    <ProjectReference Include="../../src/DiscImageStudio.ImageIO/DiscImageStudio.ImageIO.csproj" />
    <Compile Include="../../src/DiscImageStudio.App/Localization/PresetText.cs" Link="PresetText.cs" />
    <Compile Include="../../tools/FourLevelDither/DitherMode.cs" Link="DitherMode.cs" />
    <Compile Include="../DiscImageStudio.ArchitectureTests/BluRayEncodingTests.cs" Link="BluRayEncodingTests.cs" />
    <Compile Include="../DiscImageStudio.ArchitectureTests/UdfFilesystemTests.cs" Link="UdfFilesystemTests.cs" />
    <Compile Include="../DiscImageStudio.ArchitectureTests/MediaUdfTests.cs" Link="MediaUdfTests.cs" />
    <Compile Include="../DiscImageStudio.ArchitectureTests/CalibrationPatternTests.cs" Link="CalibrationPatternTests.cs" />
    <Compile Include="../DiscImageStudio.ArchitectureTests/CalibrationRingTests.cs" Link="CalibrationRingTests.cs" />
    <!-- The SDK already ships the C# parser. No additional NuGet dependency is needed. -->
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
