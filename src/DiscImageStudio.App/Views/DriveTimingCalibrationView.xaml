<UserControl x:Class="DiscImageStudio.Views.DriveTimingCalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DiscImageStudio.Localization"
             xmlns:controls="clr-namespace:DiscImageStudio.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,0,12">
            <TextBlock Text="{loc:Text Timing.Intro}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,16" />
            <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Text Timing.PrepareTitle}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{loc:Text Timing.PrepareHelp}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <WrapPanel>
                        <StackPanel MinWidth="130" Margin="0,0,16,12">
                            <TextBlock Text="{loc:Text Xaml.DiscType}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding TimingMediaChoices}" SelectedItem="{Binding SelectedDiscType}"
                                      IsEnabled="{Binding CanEditTiming}" AutomationProperties.Name="{loc:Text Xaml.DiscType}" />
                        </StackPanel>
                        <StackPanel MinWidth="210" Margin="0,0,16,12">
                            <TextBlock Text="{loc:Text Timing.TotalSectors}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                            <TextBox Text="{Binding TimingTotalSectors, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditTiming}"
                                     AutomationProperties.Name="{loc:Text Timing.TotalSectors}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{loc:Text Timing.CapacityHelp}" Style="{StaticResource CompactHint}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <WrapPanel>
                        <Button Command="{Binding StreamBurnTimingImageCommand}" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,12,8" Padding="14,8" AutomationProperties.AutomationId="StreamBurnTimingImage">
                            <TextBlock Text="{loc:Text Timing.StreamBurn}" TextWrapping="Wrap" />
                        </Button>
                        <Button Command="{Binding GenerateTimingImageCommand}" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,0,8" Padding="14,8">
                            <TextBlock Text="{loc:Text Timing.CreateImage}" TextWrapping="Wrap" />
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Text Timing.MeasureTitle}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{loc:Text Timing.MeasureHelp}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <WrapPanel>
                        <StackPanel MinWidth="280" Margin="0,0,16,12">
                            <TextBlock Text="{loc:Text Timing.Drive}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding CapacityRecorders}" SelectedItem="{Binding SelectedCapacityRecorder}"
                                      DisplayMemberPath="DisplayName" IsEnabled="{Binding CanEditTiming}"
                                      AutomationProperties.Name="{loc:Text Timing.Drive}" />
                        </StackPanel>
                        <Button Content="{loc:Text Timing.Refresh}" Command="{Binding RefreshTimingReadersCommand}"
                                Style="{StaticResource CompactButton}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <StackPanel MinWidth="210" Margin="0,0,0,12">
                            <TextBlock Text="{loc:Text Timing.ReadSpeed}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                            <TextBox Text="{Binding TimingReadSpeed, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditTiming}"
                                     AutomationProperties.Name="{loc:Text Timing.ReadSpeed}" />
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Command="{Binding MeasureDriveTimingCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8" Padding="14,8">
                            <TextBlock Text="{loc:Text Timing.Measure}" TextWrapping="Wrap" />
                        </Button>
                        <Button Content="{loc:Text Xaml.Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8" />
                        <Button Command="{Binding OpenTimingRecordCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8">
                            <TextBlock Text="{loc:Text Timing.OpenRecord}" TextWrapping="Wrap" />
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="{Binding TimingStatus}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <controls:VisibilityGate IsOpen="{Binding HasTimingResult}">
                <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{loc:Text Timing.ResultTitle}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding TimingSummary}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding TimingResultHint}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button Command="{Binding ApplyTimingResultCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8" Padding="14,8" AutomationProperties.AutomationId="ApplyDriveTiming">
                                <TextBlock Text="{loc:Text Timing.Apply}" TextWrapping="Wrap" />
                            </Button>
                            <Button Command="{Binding SaveTimingRecordCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8">
                                <TextBlock Text="{loc:Text Timing.SaveRecord}" TextWrapping="Wrap" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </controls:VisibilityGate>
        </StackPanel>
    </ScrollViewer>
</UserControl>
